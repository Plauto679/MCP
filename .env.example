# Polymarket API Credentials (CLOB)
# These are generated using your Private Key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Wallet Private Key (Required for signing trades and generating API keys)
# Ensure this corresponds to the Polygon address you want to trade with.
PRIVATE_KEY=

# MCP Configuration
LOG_LEVEL=INFO
